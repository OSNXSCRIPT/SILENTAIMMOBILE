local function GET(url)
    local r
    if not pcall(function() r = game:HttpGet(url, true) end) then
        pcall(function() r = HS:GetAsync(url, true) end)
    end
    return r
end

local function CHECK(key)
    local raw = GET(BASE .. key .. "?key=" .. APIKEY)
    if not raw then return false, "Network error" end
    local ok, d = pcall(HS.JSONDecode, HS, raw)
    if not ok or not d or not d.fields then return false, "Invalid key" end
    local f = d.fields
    if not (f.enabled and f.enabled.booleanValue) then return false, "Key disabled" end
    local uses = tonumber(f.uses    and f.uses.integerValue)    or 0
    local mx   = tonumber(f.maxUses and f.maxUses.integerValue) or 0
    if mx > 0 and uses >= mx then return false, "Max uses reached" end
    return true
end

