local activeSubTabBtns = {}
local function clearSubTabs() for _,b in ipairs(activeSubTabBtns) do b:Destroy() end; activeSubTabBtns = {} end

local function buildSubTabs(tabsList)
    clearSubTabs()
    if #tabsList <= 1 then
        setContentOffset(false)
        for _,p in pairs(Pages) do p.Visible = false end
        if #tabsList == 1 then tabsList[1].page.Visible = true end
        return
    end
    setContentOffset(true); for _,p in pairs(Pages) do p.Visible = false end
    local TAB_W = 120; local TAB_H = 34; local START_X = 12; local btnRefs = {}
    local function setActive(idx)
        for _,p in pairs(Pages) do p.Visible = false end
        tabsList[idx].page.Visible = true
        for i,ref in ipairs(btnRefs) do
            ref.btn.TextColor3 = i == idx and P.text or P.subtext
            ref.line.BackgroundTransparency = i == idx and 0 or 1
            ref.btn.ZIndex = i == idx and 7 or 6
        end
    end
    for i,td in ipairs(tabsList) do
        local xPos = START_X + (i-1)*(TAB_W+4)
        local wrap = Instance.new("Frame",SubTabBar)
        wrap.Size = UDim2.new(0,TAB_W,0,TAB_H); wrap.Position = UDim2.new(0,xPos,0,0)
        wrap.BackgroundTransparency = 1; wrap.ZIndex = 6
        local btn = Instance.new("TextButton",wrap)
        btn.Size = UDim2.new(1,0,1,0); btn.BackgroundTransparency = 1
        btn.Text = td.name; btn.Font = Enum.Font.GothamMedium; btn.TextSize = 10
        btn.TextColor3 = P.subtext; btn.ZIndex = 6; btn.AutoButtonColor = false
        local line = Instance.new("Frame",wrap)
        line.Size = UDim2.new(0.6,0,0,2); line.Position = UDim2.new(0.2,0,1,-2)
        line.BackgroundColor3 = P.text; line.BackgroundTransparency = 1; line.BorderSizePixel = 0; line.ZIndex = 7
        table.insert(btnRefs,{btn=btn,line=line}); table.insert(activeSubTabBtns,wrap)
        local idx = i
        btn.MouseButton1Click:Connect(function() setActive(idx) end)
        btn.MouseEnter:Connect(function() if btn.TextColor3 ~= P.text then btn.TextColor3 = P.text end end)
        btn.MouseLeave:Connect(function() if line.BackgroundTransparency ~= 0 then btn.TextColor3 = P.subtext end end)
    end
    setActive(1)
end

